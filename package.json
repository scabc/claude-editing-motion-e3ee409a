{
  "name": "claude-editing-motion-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EditingMotion out/editing-motion.mp4 --concurrency=4",
    "still": "remotion still src/index.ts EditingMotion out/preview.png --frame=390",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "remotion": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
